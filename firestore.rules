rules_version = '2';

// Regras de segurança do banco (Firestore) do app do sítio.
// Antes de publicar no Firebase, troque EMAIL_DO_RESPONSAVEL pelo e-mail de quem manda no app
// e ID_DO_PROJETO pelo código do projeto no Firebase.
// No app só entra quem confirmou o e-mail e foi liberado em "Pessoas com acesso" (ou é o responsável).
// Na página de pedidos, qualquer um vê o catálogo (com as fotos dos produtos); o cliente cadastrado
// (telefone e senha) vê e muda só o próprio cadastro, faz pedidos, vê só os pedidos do próprio telefone e
// cancela os que o sítio ainda não respondeu. Se esquecer a senha, troca com o CPF do cadastro.
// O cadastro do cliente também aparece no app (Clientes), onde o sítio pode mudar nome e endereço.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function responsavel() {
      return logado() && email() == 'EMAIL_DO_RESPONSAVEL';
    }

    function membro() {
      return logado() && exists(/databases/$(database)/documents/membros/$(email()));
    }

    function dono() {
      return responsavel()
        || (membro() && get(/databases/$(database)/documents/membros/$(email())).data.papel == 'dono');
    }

    // Cliente da página de pedidos: conta com e-mail <telefone>@cliente.ID_DO_PROJETO.firebaseapp.com
    // (domínio do próprio projeto, onde ninguém recebe e-mail).
    function cliente() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('[0-9]{10,11}@cliente[.]ID_DO_PROJETO[.]firebaseapp[.]com');
    }

    function telefoneDoCliente() {
      return request.auth.token.email.split('@')[0];
    }

    function textoOpcional(d, campo, max) {
      return !(campo in d) || d[campo] == null || (d[campo] is string && d[campo].size() <= max);
    }

    // Pedido feito pela página: só como "novo", com os campos esperados e a hora certa.
    function pedidoNovo(id) {
      let d = request.resource.data;
      let agora = request.time.toMillis();
      return d.keys().hasOnly(['id', 'nome', 'telefone', 'entrega', 'endereco', 'dataDesejada', 'itens', 'entregaCent', 'totalCent', 'obs', 'status', 'criadoEm', 'atualizadoEm'])
        && d.keys().hasAll(['id', 'nome', 'telefone', 'entrega', 'itens', 'status', 'criadoEm', 'atualizadoEm'])
        && d.id == id
        && d.status == 'novo'
        && d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 80
        && d.telefone is string && d.telefone.matches('[0-9]{10,13}')
        && d.entrega in ['entregar', 'retirar']
        && d.itens is list && d.itens.size() >= 1 && d.itens.size() <= 40
        && d.criadoEm is int && d.atualizadoEm == d.criadoEm
        && d.criadoEm > agora - 43200000 && d.criadoEm < agora + 3600000
        && textoOpcional(d, 'endereco', 300)
        && textoOpcional(d, 'obs', 500)
        && textoOpcional(d, 'dataDesejada', 10)
        && (!('totalCent' in d) || d.totalCent == null || d.totalCent is int)
        && (!('entregaCent' in d) || d.entregaCent == null || d.entregaCent is int);
    }

    // Cadastro gravado pela página: só os campos esperados e a hora certa.
    function cadastroValido(tel) {
      let d = request.resource.data;
      let agora = request.time.toMillis();
      return d.keys().hasOnly(['telefone', 'nome', 'cpf', 'endereco', 'numero', 'bairro', 'cidade', 'referencia', 'foto', 'criadoEm', 'atualizadoEm'])
        && d.telefone == tel
        && d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 80
        && textoOpcional(d, 'cpf', 14)
        && textoOpcional(d, 'endereco', 200)
        && textoOpcional(d, 'numero', 20)
        && textoOpcional(d, 'bairro', 100)
        && textoOpcional(d, 'cidade', 100)
        && textoOpcional(d, 'referencia', 200)
        && (!('foto' in d) || d.foto == null || (d.foto is string && d.foto.size() <= 100000 && d.foto.matches('data:image/jpeg;base64,.*')))
        && d.criadoEm is int && d.atualizadoEm is int
        && d.atualizadoEm > agora - 43200000 && d.atualizadoEm < agora + 3600000;
    }

    match /membros/{mail} {
      allow read: if responsavel() || membro();
      allow write: if dono();
    }

    match /{colecao}/{id} {
      allow read, write: if (responsavel() || membro())
        && colecao in ['produtos', 'clientes', 'fornecedores', 'vendas', 'despesas', 'estoque', 'ajustes', 'pedidos', 'catalogo', 'cadastros', 'fotos', 'orcamentos'];
    }

    // Página de pedidos: produtos que o sítio escolheu mostrar, e as fotos dos produtos.
    match /catalogo/{id} {
      allow read: if true;
    }

    match /fotos/{id} {
      allow read: if true;
    }

    // Página de pedidos: cadastro do cliente (nome, CPF, endereço e foto), guardado pelo telefone.
    // O app também lê e muda (regra de cima), para o cadastro ser o mesmo nos dois.
    match /cadastros/{tel} {
      allow read: if responsavel() || membro() || (cliente() && tel == telefoneDoCliente());
      allow create, update: if cliente() && tel == telefoneDoCliente() && cadastroValido(tel);
    }

    // Página de pedidos: a senha do cliente trancada com o CPF dele, para ele mesmo trocar a senha se esquecer.
    // Qualquer um lê o de um telefone (sem listar os outros), mas só destranca quem sabe o CPF.
    match /recuperar/{tel} {
      allow get: if true;
      allow create, update: if cliente() && tel == telefoneDoCliente()
        && request.resource.data.keys().hasOnly(['telefone', 'sal', 'iv', 'cifra', 'atualizadoEm'])
        && request.resource.data.telefone == tel
        && request.resource.data.sal is string && request.resource.data.sal.size() <= 64
        && request.resource.data.iv is string && request.resource.data.iv.size() <= 64
        && request.resource.data.cifra is string && request.resource.data.cifra.size() <= 200
        && request.resource.data.atualizadoEm is int;
    }

    // Página de pedidos: o cliente faz pedidos no próprio telefone e vê só os dele.
    // Enquanto o sítio não responde, ele pode cancelar (só muda a situação para "cancelado").
    match /pedidos/{id} {
      allow read: if cliente() && resource.data.telefone == telefoneDoCliente();
      allow create: if cliente() && pedidoNovo(id) && request.resource.data.telefone == telefoneDoCliente();
      allow update: if cliente() && resource.data.telefone == telefoneDoCliente()
        && resource.data.status == 'novo'
        && request.resource.data.status == 'cancelado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'atualizadoEm'])
        && request.resource.data.atualizadoEm is int
        && request.resource.data.atualizadoEm > resource.data.atualizadoEm
        && request.resource.data.atualizadoEm < request.time.toMillis() + 3600000;
    }
  }
}
